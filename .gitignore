# Environment files with secrets
**/.env
**/*.env

# Traefik secrets
traefik/cloudflare.env
traefik/cf_api_token.txt
**/acme.json
traefik/users

# SSL certificates and keys
**/*.pem
**/*.key
**/cert.crt
**/cert.key

# Home Assistant secrets
home-assistant/config/secrets.yaml
home-assistant/config/.storage/*

# Navidrome/LRCGET config - ignore runtime/cache data
navidrome/lrcget-config/.cache/
navidrome/lrcget-config/.config/
navidrome/lrcget-config/.local/
navidrome/lrcget-config/.dbus/
navidrome/lrcget-config/.bashrc

# General cache patterns (for any container config dirs)
**/.cache/
**/.config/pulse/
**/.config/dconf/
**/.dbus/
**/mesa_shader_cache/
**/fontconfig/*.cache-*

# SQLite databases (runtime data)
**/*.sqlite
**/*.sqlite3
**/*.sqlite3-shm
**/*.sqlite3-wal

# Binary files that shouldn't be committed
**/.local/bin/

# Salt/crypto files
**/salt

# Data directories
**/data/
**/db-data/
**/pgadmin-data/
**/pgdata/

# Database dumps (generated by backup script)
**/dumps/

# Logs
**/logs/
**/*.log

# Database files
mariadb/config/databases/
mariadb/config/log/
**/core
**/core.*
**/*.db
**/*.db-shm
**/*.db-wal
**/*.db.mv.db

# Binary logs
**/*.log.*
**/wget-log

# Grafana data
monitoring/grafana/plugins/
monitoring/grafana/*.db

# InfluxDB data
monitoring/influxdb/
monitoring/graphite/

# ML model caches
**/model-cache/
**/tsdata/

# Syncthing data
syncthing/docs/

# Nextcloud app data
nextcloud/data/

# IDE and system
.vscode/
.idea/
.DS_Store
*.swp
*~

# Python
**/__pycache__/
**/venv/
**/*.pyc

# Node
**/node_modules/

# Garmin Exports
garmin-fetch-data/export/*
# Garmin OAuth tokens (auto-generated, contain secrets)
garmin-fetch-data/garmin_tokens_data/
# Garmin Grafana subproject (separate repo)
garmin-fetch-data/garmin-grafana/

# Booklore sync state (runtime data)
booklore/sync-bridge/state/
# Docker volumes (named volumes stored elsewhere)
# Local data that shouldn't be in git

# Music automation stack - config contains API keys and databases
qbittorrent/config/
prowlarr/config/
lidarr/config/
slskd/config/
