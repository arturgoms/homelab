# Navidrome Connection
NAVIDROME_URL=https://music.example.com
NAVIDROME_USER=your_username
NAVIDROME_PASS=your_password

# Last.fm API (public API for popularity data only)
# Get your API key at: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key

# Playlist Configuration
PLAYLIST_SIZE=50
PLAYLIST_FOR_YOU_NAME=Daily Mix - For You
PLAYLIST_DISCOVER_NAME=Daily Mix - Discover

# Scheduler Configuration (cron format: minute hour day month weekday)
SCHEDULE_CRON=0 6 * * *

# Algorithm Tuning
MIN_PLAY_COUNT_FOR_TOP_ARTIST=5
MAX_PLAY_COUNT_FOR_DISCOVER=3
SIMILAR_ARTIST_DEPTH=3
LASTFM_MIN_LISTENERS=1000

# Logging
LOG_LEVEL=INFO
